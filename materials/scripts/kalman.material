// Material del logo de Kalman Robotics para el suelo del escenario.
//
// Gazebo Classic busca estos scripts en <uri>model://.../materials/scripts</uri>
// y las texturas en el materials/textures de al lado.
//
// La textura ya viene compuesta sobre blanco: el PNG original es 95%
// transparente y Gazebo pinta el alfa en negro, asi que un logo con fondo
// transparente se veria como un rectangulo negro en el suelo.

material Kalman/Logo
{
  technique
  {
    pass
    {
      ambient 0.85 0.85 0.85 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.05 0.05 0.05 1.0 2.0

      texture_unit
      {
        texture kalman_logo.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}

// El logo de HRFEST va en tonos casi blancos (brillo medio 240 sobre 255), asi
// que su textura se compuso sobre azul oscuro en vez de blanco: sobre fondo
// claro no se veria nada. El azul es el mismo de las paredes del escenario.
material Kalman/HRFest
{
  technique
  {
    pass
    {
      ambient 0.85 0.85 0.85 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.05 0.05 0.05 1.0 2.0

      texture_unit
      {
        texture hrfest_logo.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}
