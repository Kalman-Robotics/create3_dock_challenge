// Logos del escenario.
//
// Las texturas son PNG RGBA con el fondo transparente del original. Para que
// Gazebo respete ese alfa en vez de pintarlo negro hacen falta tres cosas en
// el pass:
//
//   scene_blend alpha_blend   mezcla el logo con lo que hay detras
//   depth_write off           evita que el plano tape lo que tiene detras
//   lighting off              color plano, sin sombreado del suelo
//
// Sin depth_write off se ven artefactos donde el plano toca el suelo.

material Kalman/Logo
{
  technique
  {
    pass
    {
      scene_blend alpha_blend
      depth_write off
      lighting off

      texture_unit
      {
        texture kalman_logo.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}

material Kalman/HRFest
{
  technique
  {
    pass
    {
      scene_blend alpha_blend
      depth_write off
      lighting off

      texture_unit
      {
        texture hrfest_logo.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}
