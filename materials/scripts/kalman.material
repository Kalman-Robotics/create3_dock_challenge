// Logos del escenario.
//
// Las texturas son PNG RGBA con el fondo transparente del original. Para que
// Gazebo respete ese alfa en vez de pintarlo negro hacen falta tres cosas en
// el pass:
//
//   scene_blend alpha_blend   mezcla el logo con lo que hay detras
//   depth_write off           evita que el plano tape lo que tiene detras
//   lighting off              color plano, sin sombreado del suelo
//
// Sin depth_write off se ven artefactos donde el plano toca el suelo.

material Kalman/Logo
{
  technique
  {
    pass
    {
      scene_blend alpha_blend
      depth_write off
      lighting off

      texture_unit
      {
        texture kalman_logo.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}

material Kalman/HRFest
{
  technique
  {
    pass
    {
      scene_blend alpha_blend
      depth_write off
      lighting off

      texture_unit
      {
        texture hrfest_logo.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}

// Suelo de marmol gris del escenario.
//
// La textura se recorto a 1024x1024 (2x2 baldosas de 512 px) para que sea
// CUADRADA. La original era 1536x1024 (3x2 baldosas), o sea aspecto 1.5, y con
// el mismo scale en U y V las baldosas salian 1.5 veces mas anchas que altas.
// Con textura cuadrada el scale uniforme da baldosas cuadradas.
//
// Cada baldosa mide 60 cm, luego la textura cubre 1.2 x 1.2 m. Sobre el plano
// de 100x100 m se repite 100/1.2 = 83 veces -> scale 0.012.
// Bajar el scale agranda las baldosas; subirlo las hace mas pequenas.
//
// Sin scene_blend: el suelo es opaco, no necesita mezcla.
material Kalman/FloorMarble
{
  technique
  {
    pass
    {
      ambient 0.7 0.7 0.7 1.0
      diffuse 1.0 1.0 1.0 1.0
      specular 0.08 0.08 0.08 1.0 6.0

      texture_unit
      {
        texture floor_marble.png
        filtering anisotropic
        max_anisotropy 8
        scale 0.012 0.012
      }
    }
  }
}
