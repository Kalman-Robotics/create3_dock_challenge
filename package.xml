<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>create3_dock_challenge</name>
  <version>1.0.0</version>
  <description>
    Reto de docking con LiDAR para el iRobot Create 3 en Gazebo Classic.
    El robot debe volver a su estacion de carga usando solo el LiDAR, detectando
    dos cajas marcadoras montadas en la pared detras del dock. La accion /dock
    nativa queda bloqueada.
  </description>
  <maintainer email="alaurao@uni.pe">Kalman Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>irobot_create_common_bringup</exec_depend>
  <exec_depend>irobot_create_control</exec_depend>
  <exec_depend>irobot_create_description</exec_depend>
  <exec_depend>irobot_create_gazebo_bringup</exec_depend>
  <exec_depend>irobot_create_gazebo_plugins</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>irobot_create_nodes</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
